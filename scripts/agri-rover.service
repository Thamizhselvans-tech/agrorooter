[Unit]
Description=Agri Rover AI Plant Disease Classification Backend
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/agrorooter/backend
EnvironmentFile=/home/pi/agrorooter/backend/.env
ExecStart=/home/pi/agrorooter/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
