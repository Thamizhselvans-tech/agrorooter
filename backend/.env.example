# Agri Rover AI Backend Environment Configuration
APP_NAME=Agri Rover AI
APP_VERSION=1.0.0
DEBUG=false

# Hardware Configuration (Logitech USB Webcam)
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# File Paths (relative or absolute)
MODEL_PATH=plant_disease_model/plant_disease_model.tflite
LABELS_PATH=plant_disease_model/class_names.json
CAPTURES_DIR=captures
DATABASE_PATH=predictions.db
MAX_CAPTURES_STORED=500

# Security & CORS
# In production, set CORS_ORIGINS to your Vercel deployment domain, e.g.:
# CORS_ORIGINS=https://agri-rover-ai.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,*

# Optional: Set an API Secret Key to require authentication on Raspberry Pi endpoints
# API_KEY=your_secure_random_token_here
API_KEY=

# Server Binding
HOST=0.0.0.0
PORT=8000
