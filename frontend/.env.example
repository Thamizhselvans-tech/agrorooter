# Agri Rover AI Frontend Environment Variables

# Base URL for Raspberry Pi backend API via Cloudflare Tunnel or direct IP.
# In local development with Vite proxy, leave empty or set to http://127.0.0.1:8000.
# In production on Vercel, set this to your secure HTTPS Cloudflare Tunnel URL, e.g.:
# VITE_API_BASE=https://agri-rover-api.yourdomain.com
# OR for quick tunnels:
# VITE_API_BASE=https://<random-subdomain>.trycloudflare.com
VITE_API_BASE=

# Optional: API Secret Key if authentication is enabled on the backend
VITE_API_KEY=
